{
  "project": {
    "title": "InduGraph-GNN: Graph Neural Networks for Predictive Maintenance in Indian Smart Manufacturing",
    "institution": "Centre for Industrial AI Research (CIAIR), IIT Bombay — Industry Partnership",
    "pi": "Dr. Ananya Mehta",
    "collaborator": "Bharat Precision Industries Pvt. Ltd.",
    "grantId": "DST/TMD/SMART-MFG/2024/InduGraph/042",
    "status": "Phase II — Field Validation",
    "started": "2024-01-15",
    "hypothesis": "Modeling factory assets as heterogeneous industrial graphs (machines, sensors, correlations) with spatio-temporal GNN layers yields ≥8% improvement in RUL MAE and ≥5% in fault F1 over LSTM baselines on real Indian shop-floor data.",
    "objectives": [
      "Construct dynamic heterogeneous graphs from multi-sensor industrial telemetry",
      "Develop InduGraph-GNN architecture with graph attention and temporal encoding",
      "Validate on 3 Indian manufacturing plants with 8 asset classes",
      "Benchmark against LSTM, Random Forest, and Transformer baselines",
      "Deploy edge inference pipeline with <50ms latency for production use"
    ],
    "publications": [
      { "title": "InduGraph-GNN: Heterogeneous Graph Learning for Predictive Maintenance", "venue": "Under review — IEEE Transactions on Industrial Informatics", "year": 2026, "status": "submitted" },
      { "title": "Spatio-Temporal GNN for Indian Smart Factory Degradation Modeling", "venue": "ICML 2025 Workshop on ML for Industry", "year": 2025, "status": "accepted" }
    ]
  },
  "methodology": {
    "graphConstruction": "Nodes: {factory, machine, sensor}. Edges: contains, monitors, correlates (Pearson r>0.6). Graph rebuilt every 30s from live stream.",
    "architecture": "3-layer HeteroGAT + GRU temporal encoder → multi-task heads (RUL regression, fault classification, anomaly score)",
    "lossFunction": "L = λ₁·MSE(RUL) + λ₂·CE(fault) + λ₃·BCE(anomaly), λ=[0.4, 0.35, 0.25]",
    "training": "AdamW lr=1e-3, batch=32 graphs, 200 epochs, early stopping patience=15, 5-fold temporal CV",
    "hardware": "NVIDIA A100 40GB (training), Intel Xeon edge node (inference), ap-south-1 deployment"
  },
  "experiments": [
    { "id": "EXP-001", "name": "InduGraph-GNN v2.1 (Production)", "status": "deployed", "date": "2026-07-28", "epochs": 200, "bestEpoch": 167, "lr": 0.001, "batchSize": 32, "f1": 0.912, "accuracy": 94.2, "rulMae": 18.4, "rulRmse": 24.7, "auc": 0.967, "latencyMs": 45, "params": "2.4M", "notes": "Current production model — heterogeneous GAT + GRU" },
