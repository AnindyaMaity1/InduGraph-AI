  "labNotebook": [
    { "id": "NB-001", "date": "2026-08-12", "author": "Dr. Mehta", "tag": "Finding", "title": "Correlation edges improve bearing fault detection by 4.2%", "content": "Ablation EXP-A3 confirms that machine-machine correlation edges (Pearson r>0.6) are critical for cross-asset fault propagation detection. Removing them drops F1 from 0.912 to 0.889 on the Pune plant subset." },
    { "id": "NB-002", "date": "2026-08-08", "author": "R. Sharma", "tag": "Experiment", "title": "MC Dropout uncertainty calibration on RUL", "content": "EXP-006 with T=20 MC Dropout samples achieves 92% coverage on 90% prediction intervals. Recommended for deployment on critical assets (health < 60%)." },
    { "id": "NB-003", "date": "2026-07-28", "author": "Dr. Mehta", "tag": "Deployment", "title": "v2.1 deployed to ap-south-1 production", "content": "Model passed field validation on all 3 plants. Inference latency p99=45ms. Monitoring dashboard live. Next: publish TII paper with field results." },
    { "id": "NB-004", "date": "2026-07-15", "author": "P. Venkatesh", "tag": "Data", "title": "Chennai plant data quality audit", "content": "Identified 2.3% missing readings in Conveyor CV-200 sensor stream. Applied forward-fill + uncertainty flagging. Retrain scheduled for August." },
    { "id": "NB-005", "date": "2026-06-20", "author": "R. Sharma", "tag": "Hypothesis", "title": "Graph vs sequence: when does GNN win?", "content": "GNN advantage is largest (+11% F1) when assets share utility dependencies (compressor → multiple machines). Single isolated assets show only +3% gain. Paper Section 4.3." },
    { "id": "NB-006", "date": "2026-05-01", "author": "Dr. Mehta", "tag": "Review", "title": "ICML workshop paper accepted", "content": "Reviewer 2 requested ablation on heterogeneous node types — added to EXP-A5. Camera-ready due Sept 2026." }
  ],
