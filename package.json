{
  "name": "indugraph-ai",
  "version": "1.0.0",
  "description": "InduGraph AI — GNN-powered predictive maintenance SaaS for Indian manufacturing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
